	mini_dump_mode {
		compatible = "qcom,minidump";
		status = "ok";
	};

	scm_user_intf_device {
		compatible = "qcom,scm-user-intf";
		scm_dev = "scm";
		status = "ok";
	};

	scm_user_intf_sec_device {
		compatible = "qcom,scm-user-intf-sec";
		status = "ok";
	};

	dload_mode {
		compatible = "qcom,dload-mode";
		status = "ok";
	};

	kiumd {
		compatible = "qcom,kiumd";
		qcom,dev-name = "kiumd";
		status = "ok";
	};

	adreno_smmu_fusa {
		compatible = "qcom,smmu500-tbu-fusa";
		reg = <0x0 0x3da8000 0x0 0x20>,
		      <0x0 0x3dc8000 0x0 0x18000>;
		reg-name = "smmu_fusa_base", "client_fusa_base";
		qcom,client_offset = <0x8000>;
		interrupts = <GIC_SPI 769 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 818 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 819 IRQ_TYPE_LEVEL_HIGH>;
	};

	apps_smmu_fusa {
		compatible = "qcom,smmu500-tbu-fusa";
		reg = <0x0 0x15008000 0x0 0x20>,
		      <0x0 0x15180000 0x0 0x80000>;
		reg-name = "smmu_fusa_base", "client_fusa_base";
		qcom,client_offset = <0x8000>;
		interrupts = <GIC_SPI 779 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 453 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 458 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 717 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 718 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 662 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 667 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 671 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 716 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 762 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 767 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 829 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 821 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 466 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 461 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 464 IRQ_TYPE_LEVEL_HIGH>;
	};

	pcie_smmu_fusa {
		compatible = "qcom,smmu500-tbu-fusa";
		reg = <0x0 0x15208000 0x0 0x20>,
		      <0x0 0x152f0000 0x0 0x10000>;
		reg-name = "smmu_fusa_base", "client_fusa_base";
		qcom,client_offset = <0x8000>;
		interrupts = <GIC_SPI 652 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 645 IRQ_TYPE_LEVEL_HIGH>;
	};

	kryo_erp: erp {
	compatible = "arm,arm64-kryo-cpu-erp";
	interrupts = <GIC_PPI 0 IRQ_TYPE_LEVEL_LOW>,
			<GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "l1-l2-faultirq",
				"l3-c0-scu-faultirq",
				"l3-c1-scu-faultirq";
	};

	ddr_bwprofiler {
			compatible = "qcom,sa8255_ddr_bwprofiler";
			reg = <0x0 0x9200000 0x0 0x100000>,
			      <0x0 0x9300000 0x0 0x100000>,
			      <0x0 0x9400000 0x0 0x100000>,
			      <0x0 0x9500000 0x0 0x100000>,
			      <0x0 0x9600000 0x0 0x100000>,
			      <0x0 0x9700000 0x0 0x100000>,
			      <0x0 0x9152000 0x0 0x001000>,
			      <0x0 0x9153000 0x0 0x001000>,
			      <0x0 0x9154000 0x0 0x001000>,
			      <0x0 0x9155000 0x0 0x001000>,
			      <0x0 0x9156000 0x0 0x001000>,
			      <0x0 0x9157000 0x0 0x001000>,
			      <0x0 0x17A0000 0x0 0x040000>;
	};

	scmi_mdss0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi16_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss0";
	};

	scmi_mdss1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi17_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss1";
	};

	scmi_mdss0_safe {
		compatible = "qcom,uscmi";

		power-domains = <&scmi38_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss0_safe";
	};

	scmi_mdss1_safe {
		compatible = "qcom,uscmi";

		power-domains = <&scmi39_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss1_safe";
	};

	scmi_mdss0_secure {
		compatible = "qcom,uscmi";

		power-domains = <&scmi40_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss0_secure";
	};

	scmi_mdss1_secure {
		compatible = "qcom,uscmi";

		power-domains = <&scmi41_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss1_secure";
	};

	scmi_gfx {
		compatible = "qcom,uscmi";

		power-domains = <&scmi18_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_gfx";
	};

	scmi_nsp0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp0";
	};

	scmi_nsp1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 1>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp1";
	};

	scmi_gpdsp0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 2>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_gpdsp0";
	};

	scmi_gpdsp1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 3>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_gpdsp1";
	};

	scmi_video {
		compatible = "qcom,uscmi";

		power-domains = <&scmi20_dvfs 0>, <&scmi20_dvfs 1>;
		power-domain-names = "perf_video_clk", "perf_video_bw";

		resets = <&scmi20_rst 0>;
		reset-names = "reset_video";

		qcom,dev-name = "scmi_video";
	};

	scmi_camera {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 0>;
		power-domain-names = "perf_camera";

		qcom,dev-name = "scmi_camera";
	};

	scmi_eva {
		compatible = "qcom,uscmi";

		power-domains = <&scmi22_dvfs 0>, <&scmi22_dvfs 1>;
		power-domain-names = "perf_eva_clk", "perf_eva_bw";

		qcom,dev-name = "scmi_eva";
	};

	scmi_gpce {
		compatible = "qcom,uscmi";

		power-domains = <&scmi30_dvfs 0>;
		power-domain-names = "gpce_clock";

		qcom,dev-name = "scmi_gpce";
	};

	test_scmi {
		compatible = "qcom,uscmi";

		power-domains = <&scmi63_pd 2> , <&scmi63_dvfs 2>;
		power-domain-names = "power", "perf";

		resets = <&scmi63_rst 0>;
		reset-names = "core";

		qcom,dev-name = "test_scmi";
	};

	test_scmi_perf {
		compatible = "qcom,uscmi";

		power-domains = <&scmi63_dvfs 1>;
		power-domain-names = "perf";

		qcom,dev-name = "test_scmi_perf";
	};

	test_scmi_power {
		compatible = "qcom,uscmi";

		power-domains = <&scmi63_pd 1>;

		qcom,dev-name = "test_scmi_power";
	};

	qfprom_pte: qfprom@780158 {
		compatible = "qcom,sm8450-qfprom";
		reg = <0x0 0x00780158 0x0 0x4>;
		#address-cells = <1>;
		#size-cells = <1>;
	};

	qfprom_tcsr: qfprom@1FFF018 {
		compatible = "qcom,sm8450-qfprom";
		reg = <0x0 0x1FFF018 0x0 0x4>;
		#address-cells = <1>;
		#size-cells = <1>;
	};

	qcom,dma-heaps {
		compatible = "qcom,dma-heaps";
		status = "okay";

		qcom,non-ecc {
			qcom,dma-heap-name = "qcom,non-ecc";
			qcom,dma-heap-type = <HEAP_TYPE_CARVEOUT>;
			memory-region = <&non_ecc_heap_mem>;
		};
	};

	qcom,secure-buffer {
		compatible = "qcom,secure-buffer";
	};

	tlmm_fusa {
		compatible = "qcom,tlmm-fusa";
		interrupts = <GIC_SPI 445 IRQ_TYPE_EDGE_RISING>;
		reg = <0x0 0xf1b3000 0x0 0x2>,
		      <0x0 0xf1bb000 0x0 0x4>,
		      <0x0 0xf1bb008 0x0 0x4>;
		reg-names = "error_status", "ahb_hreset_status", "por_ares_status";
		qcom,por-ares-reset-bit = <2>;
	};
};

&tlmm {
	ethernet0_default: ethernet0-default-state {
		ethernet0_mdc: ethernet0-mdc-pins {
			pins = "gpio8";
			function = "emac0_mdc";
			drive-strength = <16>;
			bias-pull-up;
		};

		ethernet0_mdio: ethernet0-mdio-pins {
			pins = "gpio9";
			function = "emac0_mdio";
			drive-strength = <16>;
			bias-pull-up;
		};

		ethernet0_pps_o_0: ethernet0-pps-o-0-pins {
			pins = "gpio6";
			function = "emac0_ptp_pps";
			output-enable;
		};

		ethernet0_pps_o_1: ethernet0-pps-o-1-pins {
			pins = "gpio10";
			function = "emac0_ptp_pps";
			output-enable;
		};

		ethernet0_pps_o_2: ethernet0-pps-o-2-pins {
			pins = "gpio11";
			function = "emac0_ptp_pps";
			output-enable;
		};

		ethernet0_pps_o_3: ethernet0-pps-o-3-pins {
			pins = "gpio12";
			function = "emac0_ptp_pps";
			output-enable;
		};
	};
};

&ethernet0 {
	pinctrl-0 = <&ethernet0_default>;
	pinctrl-names = "default";
};
