		interrupts = <GIC_SPI 475 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 476 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 601 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 602 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 603 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 290 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&pcie_smmu 0x0080 0x7f>;
		dma-coherent;
	};

	vfio_hwkm_gpce_core_0@1dc0000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x01dc0000 0x0 0x00040000>;
		iommus = <&apps_smmu 0x480 0x0>;
		qcom,iommu-dma-addr-pool = <0x0 0x0 0x0 0xffffffff>;
		dma-coherent;
